# ==============================================================================
# FidusOS v2 - Variables de entorno de ejemplo (NO incluir secretos reales aquí)
# ==============================================================================

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Modo prelanzamiento (true restringe registro público si aplica en producción)
PRELAUNCH_MODE=false

# Base de datos:
# - Desarrollo local (SQLite): sqlite:///./fidus_dev.db
# - Producción (PostgreSQL): postgresql+psycopg://usuario:password@localhost:5432/fidus_os
DATABASE_URL=sqlite:///./fidus_dev.db

# Redis (colas y workers en segundo plano en próximos hitos)
REDIS_URL=redis://localhost:6379/0

# Clave simétrica Fernet (32 bytes en base64 urlsafe) para cifrar API keys BYOK.
# Genera una nueva con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_FERNET_DE_32_BYTES_BASE64

# Secreto para firma de tokens JWT HS256.
# Genera uno nuevo con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_SECRETO_JWT_ALEATORIO_Y_LARGO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Orígenes CORS permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
