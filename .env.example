# ==============================================================================
# FidusOS v2 - Configuración Self-Hosted (Docker Compose)
# Copia este archivo a .env y sustituye ENCRYPTION_KEY y JWT_SECRET_KEY antes
# de ejecutar: docker compose up -d --build
# ==============================================================================

# Entorno y registro
ENVIRONMENT=production
PRELAUNCH_MODE=false

# Base de datos PostgreSQL 16
POSTGRES_DB=fidus_os
POSTGRES_USER=fidus
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_POSTGRES_SEGURA

# Puertos expuestos en el host
FIDUS_WEB_PORT=3000
FIDUS_API_PORT=8000

# Clave simétrica Fernet (32 bytes base64 urlsafe) para cifrar API keys BYOK.
# Genera una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_FERNET_DE_32_BYTES_BASE64

# Secreto para firma de tokens JWT HS256 (mínimo 32 caracteres).
# Genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_SECRETO_JWT_ALEATORIO_Y_LARGO

# Orígenes CORS permitidos (añade tu dominio HTTPS en producción)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
